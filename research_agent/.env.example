# Copy this file to .env and fill in real values.
# config.py loads .env automatically on startup — no `export`/`$env:`
# command needed on any OS. Just save this file and run main.py.

# Pick ONE provider — only that provider's key needs to be filled in.
LLM_PROVIDER=gemini
# LLM_PROVIDER=gemini
# LLM_PROVIDER=openai

# --- Anthropic (no persistent free tier — a one-time starter credit for new accounts) ---
ANTHROPIC_API_KEY=sk-ant-your-real-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# --- Gemini / Google AI Studio (has an ongoing free tier — good for this project) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=placeholder for the real Gemini API key. Get a key at https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI ---
OPENAI_API_KEY=sk-your-real-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Web search (Tavily, used for all research topics) ---
# Get a key at https://app.tavily.com. This is independent of the LLM key.
TAVILY_API_KEY=tvly-your-real-tavily-key-here

# --- Live market/company data, company news, and SEC filings ---
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here
FINNHUB_API_KEY=your-finnhub-key-here
# Required by SEC EDGAR. Use your name and contact email.
SEC_USER_AGENT=ResearchAgent your-email@example.com

ANALYST_MAX_TOKENS=1500
MAX_REVISIONS=2
